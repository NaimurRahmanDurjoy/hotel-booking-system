          <mxGeometry x="0.0909" y="10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Manager -> System -->
        <mxCell id="f4" value="Hotel &amp; Room Data" style="endArrow=classic;html=1;strokeColor=#FF0000;strokeWidth=2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="Manager" target="ProcessBox">
