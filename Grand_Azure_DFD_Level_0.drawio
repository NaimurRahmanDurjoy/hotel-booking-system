        <mxCell id="f7" value="Global Audit Logs" style="endArrow=classic;html=1;strokeColor=#FF0000;strokeWidth=2;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="ProcessBox" target="Admin">
          <mxGeometry x="-0.4" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
