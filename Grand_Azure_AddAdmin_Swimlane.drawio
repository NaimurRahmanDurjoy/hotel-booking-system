<mxfile>
  <diagram name="Add Admin Swimlane">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pool -->
        <mxCell id="Pool" value="Add New Admin Process" style="swimlane;html=1;childLayout=stackLayout;startSize=20;horizontal=0;horizontalStack=1;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="700" height="900" as="geometry" />
        </mxCell>

        <!-- Lane 1: Admin -->
        <mxCell id="AdminLane" value="Existing Admin" style="swimlane;html=1;startSize=20;" vertex="1" parent="Pool">
          <mxGeometry x="20" y="0" width="220" height="900" as="geometry" />
        </mxCell>
        <mxCell id="Start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;" vertex="1" parent="AdminLane">
          <mxGeometry x="95" y="40" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="A1" value="Submit New Admin&lt;br&gt;Credentials" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="AdminLane">
          <mxGeometry x="50" y="100" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="Handle Duplicate&lt;br&gt;Email Error" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="AdminLane">
          <mxGeometry x="50" y="250" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Lane 2: System -->
        <mxCell id="SystemLane" value="Grand Azure System" style="swimlane;html=1;startSize=20;" vertex="1" parent="Pool">
          <mxGeometry x="240" y="0" width="240" height="900" as="geometry" />
        </mxCell>
        <mxCell id="Dec1" value="Email Unique?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="SystemLane">
          <mxGeometry x="70" y="240" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="Create Account &amp;&lt;br&gt;Notify New Admin" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="SystemLane">
          <mxGeometry x="60" y="450" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Lane 3: New Admin -->
        <mxCell id="NewAdminLane" value="New Admin" style="swimlane;html=1;startSize=20;" vertex="1" parent="Pool">
          <mxGeometry x="480" y="0" width="200" height="900" as="geometry" />
        </mxCell>
        <mxCell id="N1" value="Log In with&lt;br&gt;Temporary Pass" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="NewAdminLane">
          <mxGeometry x="40" y="450" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="End" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeWidth=4;" vertex="1" parent="NewAdminLane">
          <mxGeometry x="85" y="600" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="e1" edge="1" parent="1" source="Start" target="A1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="A1" target="Dec1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        <mxCell id="e3" value="No" edge="1" parent="1" source="Dec1" target="A2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Yes" edge="1" parent="1" source="Dec1" target="S1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry"><mxPoint x="10" y="0" as="offset" /></mxGeometry>
        </mxCell>
        
        <mxCell id="e5" edge="1" parent="1" source="S1" target="N1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="N1" target="End" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
