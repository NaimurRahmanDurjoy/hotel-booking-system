<mxfile>
  <diagram name="Authentication Activity Diagram">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="Title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;Activity Diagram - User Authentication&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="213.5" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Start Node -->
        <mxCell id="Start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="385" y="60" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Actions -->
        <mxCell id="A1" value="Enter Email &amp; Password" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="120" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="Validate Credential Format" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="210" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Decision: Credentials Correct -->
        <mxCell id="Dec1" value="Credentials Correct?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="300" width="140" height="100" as="geometry" />
        </mxCell>

        <!-- No Path -->
        <mxCell id="F1" value="Show Error Message" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="320" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Yes Path: Role Redirect -->
        <mxCell id="S1" value="Identify User Role" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="440" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="RoleDec" value="User Role?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="520" width="120" height="90" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="Redirect to&lt;br&gt;Admin Dashboard" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="660" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="Redirect to&lt;br&gt;Manager Panel" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="660" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="Redirect to&lt;br&gt;Customer Portal" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="660" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Merge Node -->
        <mxCell id="Merge" value="" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="760" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- End Node -->
        <mxCell id="End" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeWidth=4;" vertex="1" parent="1">
          <mxGeometry x="385" y="840" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="e1" edge="1" parent="1" source="Start" target="A1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="A1" target="A2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="A2" target="Dec1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="No" edge="1" parent="1" source="Dec1" target="F1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="F1" target="A1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="350" /><mxPoint x="700" y="150" /></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="Yes" edge="1" parent="1" source="Dec1" target="S1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="S1" target="RoleDec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        <mxCell id="e8" value="Admin" edge="1" parent="1" source="RoleDec" target="R1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="Manager" edge="1" parent="1" source="RoleDec" target="R2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="Customer" edge="1" parent="1" source="RoleDec" target="R3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        <!-- FIXED ROUTING TO MERGE -->
        <mxCell id="e11" edge="1" parent="1" source="R1" target="Merge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="R2" target="Merge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="R3" target="Merge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e14" edge="1" parent="1" source="Merge" target="End" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
